CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_CORE_FORCE=y
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_RMI_DEV_FORCE=y
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_FW_UPDATE_FORCE=y
CONFIG_SECURE_TOUCH=y
CONFIG_TOUCHSCREEN_FT5X46_I2C=y
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=y
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE_SENSOR=y
CONFIG_FINGERPRINT_FPC_TEE=y
CONFIG_FINGERPRINT_GOODIX_TA=y
CONFIG_IDT_P9220=y
CONFIG_MACH_XIAOMI_D5X=y

# Network: TCP BBR Congestion Control & Fair Queue Pacing + WireGuard
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_TCP_CONG_CUBIC=y
CONFIG_DEFAULT_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_WIREGUARD=y

# Memory: Multi-Gen LRU (MGLRU) & ZRAM Default LZ4 + Writeback + ZSTD
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
# CONFIG_LRU_GEN_STATS is not set
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_LZ4HC=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_ZRAM_DEF_COMP_LZ4=y
CONFIG_ZRAM_WRITEBACK=y
CONFIG_ZRAM_MEMORY_TRACKING=y

# Compiler & Scheduler Optimization: Clang ThinLTO + 300Hz Tick + RCU Boost
# CONFIG_LTO_NONE is not set
CONFIG_LTO_CLANG=y
CONFIG_THINLTO=y
CONFIG_HZ_300=y
CONFIG_RCU_BOOST=y
CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y
CONFIG_MQ_IOSCHED_KYBER=y

# Disable Legacy QCOM Boosters & Heavy Hardware Tracing / IPC Logging Overhead
# CONFIG_CPU_BOOST is not set
# CONFIG_MSM_PERFORMANCE is not set
# CONFIG_CORESIGHT is not set
# CONFIG_IPC_LOGGING is not set
# CONFIG_MSM_TZ_LOG is not set
# CONFIG_VIDEO_ADV_DEBUG is not set
# CONFIG_RUNTIME_TESTING_MENU is not set

# Misc & Emulation: BINFMT_MISC, NTSYNC (/dev/ntsync), Re-Kernel Tombstone Netlink
CONFIG_BINFMT_MISC=y
CONFIG_NTSYNC=y
CONFIG_REKERNEL=y
CONFIG_REKERNEL_NETWORK=y

# Security: Baseband-Guard (Anti-Format Protection for Baseband/EFS)
CONFIG_BBG=y

# EROFS Read-Only Compression Filesystem (Required by Axion OS / Modern Android)
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_EROFS_FS_ZIP=y

# SELinux Default Security LSM
CONFIG_DEFAULT_SECURITY_SELINUX=y
CONFIG_DEFAULT_SECURITY="selinux"

# eBPF Tracepoints & Traffic Control Actions (Required by Android 15/16 netbpfload / bpfloader)
CONFIG_PERF_EVENTS=y
CONFIG_UPROBES=y
CONFIG_UPROBE_EVENTS=y
CONFIG_PROBE_EVENTS=y
CONFIG_TRACING=y
CONFIG_EVENT_TRACING=y
CONFIG_BPF_EVENTS=y
CONFIG_NET_ACT_BPF=y
