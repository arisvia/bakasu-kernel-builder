# ==============================================================
# Device Profile: Xiaomi Mi Mix 2S (polaris) - SDM845 Linux 4.19
# ==============================================================

DEVICE_NAME="polaris"
DEVICE_MODEL="Xiaomi Mi Mix 2S"

# Kernel Source & Branch
KERNEL_REPO="https://github.com/xiaomi-smxxx0-devs/kernel_xiaomi_sdm845-4.19"
KERNEL_BRANCH="staging5"

# Architecture and Defconfig (SDM845 4.19 unified defconfig chain)
ARCH="arm64"
KERNEL_DEFCONFIG="vendor/sdm845-perf_defconfig xiaomi/sdm845-common.config xiaomi/polaris.config"

# Target Kernel Image
KERNEL_IMAGE_NAME="Image.gz-dtb"

# Clang Toolchain (AOSP Clang r510016)
CLANG_VERSION="r510016"
CLANG_URL="https://android.googlesource.com/platform/prebuilts/clang/host/linux-x86/+archive/refs/heads/main/clang-r510016.tar.gz"

# BakaSU Configuration
KSU_HOOK_METHOD="manual"

# AnyKernel3 Template
ANYKERNEL3_REPO="https://github.com/osm0sis/AnyKernel3"
ANYKERNEL3_BRANCH="master"
