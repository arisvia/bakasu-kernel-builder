menu "Re:Kernel"

config REKERNEL
	bool "Re:Kernel support"
	default y
	help
	  Make tombstone users get a better experience by reporting
	  Binder transactions, signals, and network packets targeting
	  frozen tasks via Netlink.

config REKERNEL_NETWORK
	bool "Re:Kernel NetReceive unfreeze support"
	depends on REKERNEL
	default n
	help
	  Notify user-space tombstone daemon when incoming TCP data
	  arrives for a frozen user application.

endmenu
