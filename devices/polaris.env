# ==============================================================
# Device Profile: Xiaomi Mi Mix 2S (polaris) - SDM845 Linux 4.19
# ==============================================================

DEVICE_NAME="polaris"
DEVICE_MODEL="Xiaomi Mi Mix 2S"

# Kernel Source & Branch (maintained in this repository's sdm845 branch, Linux 4.19.325)
KERNEL_REPO="https://github.com/arisvia/bakasu-kernel-builder"
KERNEL_BRANCH="sdm845"

# Architecture and Defconfig (SDM845 4.19.325 unified defconfig chain)
ARCH="arm64"
KERNEL_DEFCONFIG="vendor/sdm845-perf_defconfig vendor/xiaomi/sdm845-common.config vendor/xiaomi/polaris.config"

# Target Kernel Image
KERNEL_IMAGE_NAME="Image.gz-dtb"

# Kernel Version Classification
KERNEL_VERSION_TYPE="4.19"

# Clang Toolchain (AOSP Clang r450784d from android13-release)
CLANG_BRANCH="android13-release"
CLANG_DIR_NAME="clang-r450784d"
GCC_BRANCH="android12L-release"

# BakaSU Configuration
KSU_HOOK_METHOD="manual"

# AnyKernel3 Template
ANYKERNEL3_REPO="https://github.com/osm0sis/AnyKernel3"
ANYKERNEL3_BRANCH="master"
