# ==============================================================
# Device Profile Template for BakaSU-Kernel-Builder
# Copy this file to devices/<codename>.env to add a new device!
# ==============================================================

# Device Codename (e.g., dipper, raphael, sunny)
DEVICE_NAME="codename"

# Human-readable Model Name (e.g., Xiaomi Mi 8, Redmi K20 Pro)
DEVICE_MODEL="Device Model Name"

# Kernel Source Git Repository URL
KERNEL_REPO="https://github.com/your-org/kernel_source_repo"

# Branch to checkout
KERNEL_BRANCH="main"

# Target CPU Architecture (typically arm64)
ARCH="arm64"

# Defconfig files (separated by spaces if multiple defconfigs/fragments are merged)
KERNEL_DEFCONFIG="vendor/your_device_defconfig"

# Expected kernel binary output name in out/arch/arm64/boot/
# Common values: Image.gz-dtb, Image.gz, Image
KERNEL_IMAGE_NAME="Image.gz-dtb"

# Clang Toolchain configuration
# AOSP Clang versions: r487747, r510016, r522817
CLANG_VERSION="r510016"
CLANG_URL="https://android.googlesource.com/platform/prebuilts/clang/host/linux-x86/+archive/refs/heads/main/clang-r510016.tar.gz"

# BakaSU Hook Mode:
# "manual" for non-GKI kernels (3.4 ~ 4.19)
# "tracepoint" for GKI kernels (5.10+)
KSU_HOOK_METHOD="manual"

# AnyKernel3 packaging template
ANYKERNEL3_REPO="https://github.com/osm0sis/AnyKernel3"
ANYKERNEL3_BRANCH="master"
